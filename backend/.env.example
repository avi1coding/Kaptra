# Copy this file to `.env` (same folder) and fill in the values you need.
# Anything already exported in your shell wins over what's here.
#
#   cp .env.example .env
#
# Then just start the backend normally — no export needed:
#   ./.venv/bin/uvicorn main:app --port 8000

# ── YouTube upload ───────────────────────────────────────────────────────────
# From Google Cloud Console → Google Auth Platform → Clients → Web application.
# The client's redirect URI must be exactly:
#   http://localhost:8000/youtube/callback
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret

# ── Optional: Anthropic ──────────────────────────────────────────────────────
# Only needed for non-English translation and LLM-picked emphasis. Style
# suggestions and English translation work without it.
# ANTHROPIC_API_KEY=

# ── Optional: Whisper ────────────────────────────────────────────────────────
# tiny · base · small · medium · large-v3 — bigger is more accurate but slower.
# WHISPER_MODEL=base
