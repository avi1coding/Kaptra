# Base URL of the Python backend (Whisper + ffmpeg).
# Leave unset to run the site in demo mode: sample transcript, .ass export only.
#
#   local        → http://127.0.0.1:8000
#   deployed     → https://your-space.hf.space  |  https://kaption-api.onrender.com
#
# Next.js inlines NEXT_PUBLIC_* at build time — restart `npm run dev` after
# changing this.
NEXT_PUBLIC_KAPTRA_API=http://127.0.0.1:8000
